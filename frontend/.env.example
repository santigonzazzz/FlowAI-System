# Plantilla de variables del frontend.
# Copialo como .env (desarrollo) o definelas en Netlify:
#   Site configuration -> Environment variables

# URL publica del backend FastAPI.
# Si NO se define, el frontend usa rutas relativas (/messages) y puedes
# resolverlas con los redirects (proxy) de netlify.toml.
VITE_API_URL=https://tu-backend.onrender.com

# Opcional: texto del motor de IA mostrado en el footer.
# VITE_AI_ENGINE=Groq llama-3.3-70b
