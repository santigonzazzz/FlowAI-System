# Variables de entorno — copia este archivo como .env y ajusta los valores.
# NUNCA subas .env a tu repositorio (ya está en .gitignore).

APP_NAME="FlowAI API"
APP_VERSION="0.1.0"
DEBUG=false

# -- IA (Groq) ----------------------------------------------------------------
# Sin clave, el sistema usa automaticamente el fallback por palabras clave.
GROQ_API_KEY=your_api_key

# -- CORS ---------------------------------------------------------------------
# Origenes permitidos para el frontend, separados por comas.
# Local: el dev server de Vite. Produccion: tu dominio de Netlify.
# Usa "*" para permitir cualquier origen (desactiva credenciales).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Futuras variables:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/flowai
# SECRET_KEY=supersecret
